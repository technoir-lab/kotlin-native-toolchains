CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
# CT_LOG_PROGRESS_BAR is not set
# CT_PREFIX_DIR_RO is not set
CT_ARCH_X86=y
CT_ARCH_64=y
# CT_MULTILIB is not set
CT_TARGET_VENDOR="w64"
CT_KERNEL_WINDOWS=y
CT_BINUTILS_V_2_40=y
CT_LIBC_MINGW_W64=y
CT_MINGW_W64_V_V14_0=y
CT_MINGW_DEFAULT_MSVCRT_MSVCRT=y
CT_MINGW_DIRECTX=y
CT_MINGW_DDK=y
CT_THREADS_POSIX=y
CT_CC_GCC=y
CT_GCC_V_13=y
CT_CC_LANG_CXX=y
CT_CC_GCC_STATIC_LIBSTDCXX=y
CT_ZLIB_V_1_2_13=y
CT_STRIP_HOST_TOOLCHAIN_EXECUTABLES=y
CT_STRIP_TARGET_TOOLCHAIN_EXECUTABLES=y
CT_REMOVE_DOCS=y
CT_INSTALL_LICENSES=y
CT_SAVE_TARBALLS=y
